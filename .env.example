# Copiá este archivo como .env y completá los valores. NO subas .env a GitHub.
DJANGO_SECRET_KEY=generar-una-clave-aleatoria-larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_COOKIES=False
# Producción con HTTPS configurado: DJANGO_DEBUG=False y DJANGO_SECURE_COOKIES=True

# Correo SMTP obligatorio para que activaciones y recuperaciones lleguen al correo real.
# No se imprimen enlaces en la consola. Para Gmail, usá contraseña de aplicación, no tu contraseña normal.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=PEGA_AQUI_UNA_NUEVA_CONTRASENA_DE_APLICACION
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Biblioteca Córdoba <tu-correo@gmail.com>

# Desarrollo local: SQLite (usa backend/db.sqlite3)
DB_ENGINE=sqlite

# Producción: al usar PostgreSQL, cambiar DB_ENGINE a postgres y completar:
# DB_ENGINE=postgres
# DB_NAME=nombre_de_la_base
# DB_USER=usuario_de_la_base
# DB_PASSWORD=contraseña_de_la_base
# DB_HOST=host_del_proveedor
# DB_PORT=5432
# DB_SSLMODE=require
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.example

# BiblioBot: mantener la clave solo como variable de entorno del servidor.
BIBLIOTECA_AI_API_KEY=
BIBLIOTECA_AI_BASE_URL=https://api.openai.com/v1/chat/completions
BIBLIOTECA_AI_MODEL=gpt-4o-mini
